# Date and time vocabulary, Turkish (tr-TR). Same sections as the other languages; the roles are described in docs/recognizers.md.
#
# Dates are day first (3 Mart 2026, 15.04.2026 and 15/04/2026 are 15 April). A form starting with "=" is case-sensitive, the others are matched
# without regard to case. A case ending written after an apostrophe ("3 Mart'ta", "20.03.2026'da") is outside the span.
# Vowel harmony makes the endings of "from ... to" ranges vary ('dan 'den 'tan 'ten; 'a 'e 'ya 'ye kadar); each variant is a form.

[time.region]
tr

[time.month]
1 | ocak, ocakta, ocaktan, ocağa
2 | şubat, şubatta, şubattan, şubata
3 | mart, martta, marttan, marta
4 | nisan, nisanda, nisandan, nisana
5 | mayıs, mayısta, mayıstan, mayısa
6 | haziran, haziranda, hazirandan, hazirana
7 | temmuz, temmuzda, temmuzdan, temmuza
8 | ağustos, ağustosta, ağustostan, ağustosa
9 | eylül, eylülde, eylülden, eylüle
10 | ekim
11 | kasım
12 | aralık

[time.weekday]
1 | pazartesi, pazarteside, pazartesiden, pazartesiye | pazartesileri
2 | salı, salıda, salıdan, salıya | salıları
3 | çarşamba, çarşambada, çarşambadan, çarşambaya | çarşambaları
4 | perşembe, perşembede, perşembeden, perşembeye | perşembeleri
5 | cuma, cumada, cumadan, cumaya | cumaları
6 | cumartesi, cumarteside, cumartesiden, cumartesiye | cumartesileri
7 | pazar | pazarları

[time.unit]
second | saniye, saniyeler, sn | 1 | 0
minute | dakika, dakikalar, dk | 60 | 0
hour | saat, saatler | 3600 | 0
day | gün, günler | 86400 | 0
week | hafta, haftalar | 604800 | 0
month | ay, aylar | 0 | 1
quarter | çeyrek, üç aylık dönem | 0 | 3
year | yıl, yıllar, sene, seneler | 0 | 12
business day | iş günü, iş günleri | 0 | 0

[time.season]
spring | ilkbahar, ilkbaharı, ilkbaharında, bahar, baharı, baharında | 3 | 3
summer | yaz, yazı, yazında, yazın | 6 | 3
fall | sonbahar, sonbaharı, sonbaharında, güz, güzün | 9 | 3
winter | kış, kışı, kışında, kışın | 12 | 3

[time.daypart]
morning | sabah, sabahı, sabahleyin | 6 | 12
afternoon | öğleden sonra, öğleden sonrası | 12 | 18
evening | akşam, akşamı, akşamleyin | 18 | 24
night | gece, gecesi | 20 | 24

[time.word]
today | bugün
tomorrow | yarın
yesterday | dün
dayaftertomorrow | öbür gün, öbürsü gün
daybeforeyesterday | evvelsi gün, evvelki gün, önceki gün
tonight | bu gece
noon | öğlen, öğle, öğle vakti
midnight | gece yarısı
this | bu
next | gelecek, önümüzdeki, sonraki
last | geçen, geçtiğimiz, önceki
ago | önce
later | sonra
every | her
approx | yaklaşık
weekend | hafta sonu
hourarticle | saat
rangeto | -, –, —, ile, 'dan, 'den, 'tan, 'ten, ’dan, ’den, ’tan, ’ten
rangetail | arasında, kadar, dek, 'a kadar, 'e kadar, 'ya kadar, 'ye kadar, 'a dek, 'e dek, 'ya dek, 'ye dek, ’a kadar, ’e kadar, ’ya kadar, ’ye kadar
zonebase | =UTC, =GMT

[time.recurrence]
P1D | day | günlük, her günkü
P1W | week | haftalık
P1M | month | aylık
P3M | quarter | üç aylık
P1Y | year | yıllık

[time.zone]
=UTC, =GMT | 0 | z
