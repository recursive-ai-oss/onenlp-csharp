<Project>
  <!-- Shared by the parts of the base-size accurate tier: each part packs one slice of the model's weights, so that
       every package stays under the 250 MB size limit of nuget.org. Without a weights directory (environment variable ONENLP_MLLARGE_WEIGHTS or
       property LargeWeightsDir) a part builds, but cannot be packed. -->
  <PropertyGroup>
    <AssemblyName>$(PackagePrefix)$(LibName).Models.Multilingual.Large.$(PartName)</AssemblyName>
    <RootNamespace>$(PackagePrefix)$(LibName).Models.Multilingual.Large.$(PartName)</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName).Models.Multilingual.Large.$(PartName)</PackageId>
    <Description>spaCy-class NLP for .NET: $(PartDescription) of the base-size accurate-tier model. Pulled in by RecursiveAI.OneNlp.Models.Multilingual.Large; reference that package, not this one. Unaffiliated with other projects named OneNLP.</Description>
    <PackageTags>$(PackageTags);model</PackageTags>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LargeWeightsDir Condition="'$(LargeWeightsDir)' == ''">$(ONENLP_MLLARGE_WEIGHTS)</LargeWeightsDir>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectDirectory)/weights.manifest.props" />

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="weights.manifest.props" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Declare copied assets during evaluation: packing without a build gathers files before build targets run. -->
  <ItemGroup Condition="'$(PartFiles)' == 'true' and '$(LargeWeightsDir)' != ''">
    <Content Include="@(LargeWeight-&gt;'$(LargeWeightsDir)/%(Identity)')"
             Link="weights/multilingual-large/heads/%(Filename)%(Extension)"
             TargetPath="weights/multilingual-large/heads/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="weights/multilingual-large/heads/%(Filename)%(Extension)" />
    <None Include="$(PackageId).targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <Target Name="EmbedLargeWeights" BeforeTargets="AssignTargetPaths;GenerateNuspec" Condition="'$(LargeWeightsDir)' != ''">
    <ItemGroup>
      <_Weight Include="@(LargeWeight)" Path="$([MSBuild]::EnsureTrailingSlash('$(LargeWeightsDir)'))%(Identity)" WeightName="%(Identity)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Weight.Path)')" Text="Weights file '%(_Weight.WeightName)' is missing from '$(LargeWeightsDir)'. Put the files listed in weights.manifest.props there." />
    <GetFileHash Files="@(_Weight->'%(Path)')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WeightHashed" />
    </GetFileHash>
    <Error Condition="!$([System.String]::Equals('%(_WeightHashed.FileHash)', '%(_WeightHashed.Sha256)', System.StringComparison.OrdinalIgnoreCase))"
           Text="Weights file '%(_WeightHashed.WeightName)' does not match the manifest: sha256 %(_WeightHashed.FileHash), expected %(_WeightHashed.Sha256). Use the weights listed in weights.manifest.props, or update the manifest and PROVENANCE.md together." />
    <ItemGroup>
      <EmbeddedResource Include="@(_WeightHashed)" LogicalName="weights/%(_WeightHashed.WeightName)" Condition="'$(PartFiles)' != 'true'" />

    </ItemGroup>
  </Target>

  <Target Name="RequireLargeWeightsToPack" BeforeTargets="GenerateNuspec" Condition="'$(LargeWeightsDir)' == ''">
    <Error Text="Packing needs the weights: set the environment variable ONENLP_MLLARGE_WEIGHTS (or the property LargeWeightsDir) to the directory that holds the files listed in weights.manifest.props." />
  </Target>
</Project>
