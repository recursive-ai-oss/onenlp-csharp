<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(PackagePrefix)$(LibName).Models.French</AssemblyName>
    <RootNamespace>$(PackagePrefix)$(LibName).Models.French</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName).Models.French</PackageId>
    <Description>spaCy-class NLP for .NET: the French fast-tier model. Tokenization with French elision and contractions, morphology, lemmas, dependency parse and PER/ORG/LOC/MISC entities for the Nlp verbs, trained on Universal Dependencies French-GSD (CC BY-SA 4.0) and WikiNER French (CC BY 4.0, over Wikipedia text). No downloads. Unaffiliated with other projects named OneNLP.</Description>
    <PackageTags>$(PackageTags);french;model</PackageTags>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The weights are embedded as resources, so a NativeAOT or trimmed application carries them with no file to copy. -->
    <FrenchWeightsDir Condition="'$(FrenchWeightsDir)' == ''">$(ONENLP_FRENCH_WEIGHTS)</FrenchWeightsDir>
  </PropertyGroup>

  <Import Project="weights.manifest.props" />

  <ItemGroup>
    <!-- The registration file is shipped, not compiled here. -->
    <Compile Remove="contentFiles/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneNlp.Neural/OneNlp.Neural.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="PROVENANCE.md" Pack="true" PackagePath="/" />
    <None Include="weights.manifest.props" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <!-- Compiled into the referencing project: the module initializer that registers the model (docs/model-packages.md). -->
    <Content Include="contentFiles/OneNlpModelsFrenchRegistration.cs" Pack="true" PackagePath="contentFiles/cs/any/" BuildAction="Compile" PackageCopyToOutput="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- With a weights directory (property FrenchWeightsDir or environment variable ONENLP_FRENCH_WEIGHTS): check every file against the
       manifest and embed it. Without one the project still builds (for development), but cannot be packed. -->
  <Target Name="EmbedFrenchWeights" BeforeTargets="AssignTargetPaths" Condition="'$(FrenchWeightsDir)' != ''">
    <ItemGroup>
      <_Weight Include="@(FrenchWeight)" Path="$([MSBuild]::EnsureTrailingSlash('$(FrenchWeightsDir)'))%(Identity)" WeightName="%(Identity)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Weight.Path)')" Text="Weights file '%(_Weight.WeightName)' is missing from '$(FrenchWeightsDir)'. Put the files listed in src/OneNlp.Models.French/weights.manifest.props there." />
    <GetFileHash Files="@(_Weight->'%(Path)')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WeightHashed" />
    </GetFileHash>
    <Error Condition="!$([System.String]::Equals('%(_WeightHashed.FileHash)', '%(_WeightHashed.Sha256)', System.StringComparison.OrdinalIgnoreCase))"
           Text="Weights file '%(_WeightHashed.WeightName)' does not match the manifest: sha256 %(_WeightHashed.FileHash), expected %(_WeightHashed.Sha256). Use the weights listed in weights.manifest.props, or update the manifest and PROVENANCE.md together." />
    <ItemGroup>
      <EmbeddedResource Include="@(_WeightHashed)" LogicalName="weights/%(_WeightHashed.WeightName)" />
    </ItemGroup>
  </Target>

  <Target Name="RequireFrenchWeightsToPack" BeforeTargets="GenerateNuspec" Condition="'$(FrenchWeightsDir)' == ''">
    <Error Text="Packing needs the weights: set the environment variable ONENLP_FRENCH_WEIGHTS (or the property FrenchWeightsDir) to the directory that holds the files listed in weights.manifest.props." />
  </Target>

</Project>
