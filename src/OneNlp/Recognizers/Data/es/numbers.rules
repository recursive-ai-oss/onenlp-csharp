# Number rules for Spanish (es-ES; es-MX differs in the digit separators, see decimal.mx and group.mx).
#
# Format: [section] headers, then one rule per line, fields separated by "|". "#" starts a comment.
# Words are matched without regard to case. Hundreds are words of their own (doscientos), tens join a unit with "y" (treinta y cinco).
# Not supported: "mil millones" (a thousand millions) as one scale word; write 7.900 millones in digits.

[number.digits]
system | iberian
decimal | ,
group | space nbsp nnbsp .
decimal.mx | .
group.mx | space nbsp nnbsp ,
negative | -−

[number.cardinal]
cero | unit | 0
un | unit | 1
uno | unit | 1
una | unit | 1
dos | unit | 2
tres | unit | 3
cuatro | unit | 4
cinco | unit | 5
seis | unit | 6
siete | unit | 7
ocho | unit | 8
nueve | unit | 9
diez | teen | 10
once | teen | 11
doce | teen | 12
trece | teen | 13
