# "एक" counts only inside a longer number ("एक सौ", "एक लाख"); alone it is the article "a"/"one" in phrases like "एक किताब".
[number.lone-skip]
एक

[number.negative]
ऋण

[number.point]
दशमलव

# A digit ordinal: 21वीं, 5वाँ, 8वें, 3रा.
[number.ordinal-suffix]
