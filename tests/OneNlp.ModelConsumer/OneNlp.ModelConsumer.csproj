<Project Sdk="Microsoft.NET.Sdk">

  <!-- A consumer of the packed packages, as a user's project would be: it restores RecursiveAI.OneNlp and (with WithModel=true) the English
       model package from a folder feed (environment variable ONENLP_CONSUMER_FEED), never from project references. Not part of the
       solution. Run it with run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(PackagePrefix)$(LibName).ModelConsumer</RootNamespace>
    <AssemblyName>$(PackagePrefix)$(LibName).ModelConsumer</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnablePackageValidation>false</EnablePackageValidation>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <WithModel Condition="'$(WithModel)' == ''">true</WithModel>
    <!-- The language package to consume: English (default), German, Portuguese or Dutch. -->
    <ModelLang Condition="'$(ModelLang)' == ''">English</ModelLang>
    <DefineConstants Condition="'$(WithModel)' != 'true'">$(DefineConstants);NO_MODEL</DefineConstants>
    <DefineConstants>$(DefineConstants);LANG_$(ModelLang.ToUpperInvariant());LANG_ENGLISH_CHECKS_$(ModelLang)</DefineConstants>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(ONENLP_CONSUMER_FEED)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OneNlp" VersionOverride="$(Version)" />
    <PackageReference Include="RecursiveAI.OneNlp.Models.$(ModelLang)" VersionOverride="$(Version)" Condition="'$(WithModel)' == 'true'" />
  </ItemGroup>

</Project>
