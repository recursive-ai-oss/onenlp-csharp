# Units that follow a number, French. Fields: canonical name | dimension | surface forms, comma-separated | confidence (optional).
# A form starting with "=" is case-sensitive; the others are matched without regard to case. Canonical names are the English ones.
# Short forms that are also common words (a, an, m as in "3 m" is kept case-sensitive) are left out on purpose.

[unit]
millimeter | length | mm, millimètre, millimètres, millimetre, millimetres
centimeter | length | cm, centimètre, centimètres, centimetre, centimetres
meter | length | =m, mètre, mètres, metre, metres
kilometer | length | km, kilomètre, kilomètres, kilometre, kilometres
micrometer | length | micron, microns, µm, μm, micromètre, micromètres
inch | length | pouce, pouces
foot | length | pied, pieds
yard | length | yard, yards
mile | length | mile, miles
nautical mile | length | mille marin, milles marins

milligram | mass | mg, milligramme, milligrammes
gram | mass | =g, gramme, grammes
kilogram | mass | kg, kilo, kilos, kilogramme, kilogrammes
microgram | mass | µg, μg, microgramme, microgrammes
tonne | mass | tonne, tonnes, =t
quintal | mass | quintal, quintaux
pound | mass | livre, livres, lb, lbs
ounce | mass | once, onces

milliliter | volume | ml, millilitre, millilitres
centiliter | volume | cl, centilitre, centilitres
