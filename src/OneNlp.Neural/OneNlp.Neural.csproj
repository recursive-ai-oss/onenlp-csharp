<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(PackagePrefix)$(LibName).Neural</AssemblyName>
    <RootNamespace>$(PackagePrefix)$(LibName).Neural</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName).Neural</PackageId>
    <Description>spaCy-class NLP for .NET: the neural layer on OneModel. Fast and transformer encoders, tagger, morphologizer, lemmatizer, dependency parser, entity recognizer, text classifier and span categorizer, Train for training and fine-tuning in C#, saved pipelines and sentence embeddings. Unaffiliated with other projects named OneNLP.</Description>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Tests" />
    <InternalsVisibleTo Include="$(PackagePrefix)$(LibName).Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneNlp/OneNlp.csproj" />
    <PackageReference Include="RecursiveAI.OneModel" />
    <PackageReference Include="RecursiveAI.OneModel.Training" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
