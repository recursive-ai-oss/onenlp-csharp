<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(PackagePrefix)$(LibName).Models.Hindi</AssemblyName>
    <RootNamespace>$(PackagePrefix)$(LibName).Models.Hindi</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName).Models.Hindi</PackageId>
    <Description>spaCy-class NLP for .NET: the Hindi fast-tier model. UPOS, morphology, dependency parse and PER/LOC/ORG entities for the Nlp verbs, trained on Hindi web text labelled by the accurate tier (there is no allowed Hindi treebank). No lemmatizer: the token text is the lemma. No downloads. An early preview. Unaffiliated with other projects named OneNLP.</Description>
    <PackageTags>$(PackageTags);hindi;model</PackageTags>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The weights are embedded as resources, so a NativeAOT or trimmed application carries them with no file to copy. -->
    <HindiWeightsDir Condition="'$(HindiWeightsDir)' == ''">$(ONENLP_HINDI_WEIGHTS)</HindiWeightsDir>
  </PropertyGroup>

  <Import Project="weights.manifest.props" />

  <ItemGroup>
    <!-- The registration file is shipped, not compiled here. -->
    <Compile Remove="contentFiles/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneNlp.Neural/OneNlp.Neural.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="PROVENANCE.md" Pack="true" PackagePath="/" />
    <None Include="weights.manifest.props" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <!-- Compiled into the referencing project: the module initializer that registers the model (docs/model-packages.md). -->
    <Content Include="contentFiles/OneNlpModelsHindiRegistration.cs" Pack="true" PackagePath="contentFiles/cs/any/" BuildAction="Compile" PackageCopyToOutput="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- With a weights directory (property HindiWeightsDir or environment variable ONENLP_HINDI_WEIGHTS): check every file against the
       manifest and embed it. Without one the project still builds (for development), but cannot be packed. -->
  <Target Name="EmbedHindiWeights" BeforeTargets="AssignTargetPaths" Condition="'$(HindiWeightsDir)' != ''">
    <ItemGroup>
      <_Weight Include="@(HindiWeight)" Path="$([MSBuild]::EnsureTrailingSlash('$(HindiWeightsDir)'))%(Identity)" WeightName="%(Identity)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Weight.Path)')" Text="Weights file '%(_Weight.WeightName)' is missing from '$(HindiWeightsDir)'. Put the files listed in src/OneNlp.Models.Hindi/weights.manifest.props there." />
    <GetFileHash Files="@(_Weight->'%(Path)')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WeightHashed" />
    </GetFileHash>
    <Error Condition="!$([System.String]::Equals('%(_WeightHashed.FileHash)', '%(_WeightHashed.Sha256)', System.StringComparison.OrdinalIgnoreCase))"
           Text="Weights file '%(_WeightHashed.WeightName)' does not match the manifest: sha256 %(_WeightHashed.FileHash), expected %(_WeightHashed.Sha256). Use the weights listed in weights.manifest.props, or update the manifest and PROVENANCE.md together." />
    <ItemGroup>
      <EmbeddedResource Include="@(_WeightHashed)" LogicalName="weights/%(_WeightHashed.WeightName)" />
    </ItemGroup>
  </Target>

  <Target Name="RequireHindiWeightsToPack" BeforeTargets="GenerateNuspec" Condition="'$(HindiWeightsDir)' == ''">
    <Error Text="Packing needs the weights: set the environment variable ONENLP_HINDI_WEIGHTS (or the property HindiWeightsDir) to the directory that holds the files listed in weights.manifest.props." />
  </Target>

</Project>
