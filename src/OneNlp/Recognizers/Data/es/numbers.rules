# The denominator a fraction word stands for: "tres cuartos" is 3/4.
[number.fraction]
tercio | 3
tercios | 3
cuartos | 4
quintos | 5
sextos | 6
séptimos | 7
octavos | 8
novenos | 9
décimos | 10
centésimos | 100
milésimos | 1000

# "un", "una" and "uno" count only inside a longer number ("treinta y uno", "un millón"); alone they are the article or a pronoun.
[number.lone-skip]
un, uno, una

[number.connector]
y

[number.negative]
menos

[number.point]
coma

[number.suffix]
k | 1000 | any
M | 1000000 | money
MM | 1000000000 | money

# A number written with an ending: 1.º 1.ª 1.er 3.er 2º 2ª 1er.
[number.ordinal-suffix]
º | 0123456789 | any
ª | 0123456789 | any
.º | 0123456789 | any
.ª | 0123456789 | any
.er | 13 | not-teen
er | 13 | not-teen
.o | 0123456789 | any
.a | 0123456789 | any

[percent]
%, por ciento, porciento, por cien, ％

[age.unit]
year | año, años
month | mes, meses
week | semana, semanas
day | día, días, dia, dias

# "82 años de edad" is an age, "82 años" alone is a length of time.
[age.suffix]
de edad

[number.not-number]
uno | after | de, entre
segundo | before | por
primera | after | hora
primero | after | hora

# National numbers written as space-separated groups: Spanish numbers have nine digits and start with 6, 7, 8 or 9 ("913 45 67 89").
[phone.space-start]
6789 | 9 | 9
