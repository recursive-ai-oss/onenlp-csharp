<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(PackagePrefix)$(LibName).Tests</RootNamespace>
    <AssemblyName>$(PackagePrefix)$(LibName).Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../testdata/accurate/**" Link="testdata/accurate/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/tokenizers/**" Link="testdata/tokenizers/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneNlp/OneNlp.csproj" />
    <ProjectReference Include="../../src/OneNlp.Neural/OneNlp.Neural.csproj" />
    <ProjectReference Include="../../tools/OneNlp.Parity/OneNlp.Parity.csproj" />
  </ItemGroup>

  <ItemGroup Label="Parity self-check fixtures">
    <None Include="Parity/toy/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
