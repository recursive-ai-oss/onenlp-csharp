# Date and time vocabulary, French (fr-FR). Same sections as the English file; the roles added for French and German are described in docs/recognizers.md.
#
# Dates are day first (le 3 mars 2026, 03/04/2026 is 3 April). A form starting with "=" is case-sensitive, the others are matched without regard to case.

[time.region]
fr

[time.month]
1 | janvier, =janv, =janv.
2 | février, fevrier, =févr, =févr., =fevr, =fevr.
3 | mars
4 | avril, =avr, =avr.
5 | mai
6 | juin
7 | juillet, =juil, =juil.
8 | août, aout
9 | septembre, =sept, =sept.
10 | octobre, =oct, =oct.
11 | novembre, =nov, =nov.
12 | décembre, decembre, =déc, =déc., =dec, =dec.

[time.weekday]
1 | lundi | lundis
2 | mardi | mardis
3 | mercredi | mercredis
4 | jeudi | jeudis
5 | vendredi | vendredis
6 | samedi | samedis
7 | dimanche | dimanches

[time.unit]
second | seconde, secondes, sec | 1 | 0
minute | minute, minutes, min | 60 | 0
hour | heure, heures | 3600 | 0
day | jour, jours, journée, journées, journee, journees | 86400 | 0
week | semaine, semaines | 604800 | 0
week | quinzaine, quinzaines | 1209600 | 0
month | mois | 0 | 1
quarter | trimestre, trimestres | 0 | 3
year | an, ans, année, années, annee, annees | 0 | 12
decade | décennie, décennies, decennie, decennies | 0 | 120
business day | jour ouvré, jours ouvrés, jour ouvrable, jours ouvrables, jour ouvre, jours ouvres | 0 | 0

[time.season]
spring | printemps | 3 | 3
summer | été, ete | 6 | 3
fall | automne | 9 | 3
winter | hiver | 12 | 3

[time.daypart]
morning | matin, matinée, matinee | 6 | 12
afternoon | après-midi, apres-midi, après midi | 12 | 18
evening | soir, soirée, soiree | 18 | 24
night | nuit | 20 | 24

