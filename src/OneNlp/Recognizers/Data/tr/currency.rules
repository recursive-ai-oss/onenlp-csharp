# Currency rules, Turkish. Same format as the other languages (see docs/recognizers.md).
#
# [currency.symbol]: form | ISO 4217 code | prefix, suffix or both | confidence (optional).
# [currency.name]:   forms, comma-separated | ISO 4217 code | value of one in the currency (optional) | confidence (optional).

[currency.symbol]
$ | USD | both | 0.9
US$ | USD | prefix
€ | EUR | both
£ | GBP | both
¥ | JPY | both | 0.7
￥ | JPY | both | 0.7
₹ | INR | both
₽ | RUB | both
₺ | TRY | both
=TL | TRY | suffix

[currency.name]
lira, liralar, türk lirası, türk liraları | TRY | 1 | 0.9
kuruş | TRY | 0.01 | 0.7
euro, euros, avro, avrolar | EUR | 1 | 0.95
dolar, dolarlar, amerikan doları, abd doları | USD | 1 | 0.9
sterlin, ingiliz sterlini, pound | GBP | 1 | 0.8
yen | JPY
yuan | CNY
rupi | INR
ruble, rubl | RUB
frank, isviçre franı | CHF | 1 | 0.6

