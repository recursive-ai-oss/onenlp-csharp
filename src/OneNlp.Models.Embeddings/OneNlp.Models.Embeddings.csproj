<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(PackagePrefix)$(LibName).Models.Embeddings</AssemblyName>
    <RootNamespace>$(PackagePrefix)$(LibName).Models.Embeddings</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName).Models.Embeddings</PackageId>
    <Description>spaCy-class NLP for .NET: the default English sentence embedder (bge-small-en-v1.5, MIT) for Nlp.Embed and SentenceEmbedder. Weights are exported from the authors' published model; nothing is trained here. No downloads. An early preview. Unaffiliated with other projects named OneNLP.</Description>
    <PackageTags>$(PackageTags);embeddings;sentence-embeddings;model</PackageTags>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The weights are embedded as resources, so a NativeAOT or trimmed application carries them with no file to copy. -->
    <EmbeddingsWeightsDir Condition="'$(EmbeddingsWeightsDir)' == ''">$(ONENLP_EMBEDDINGS_WEIGHTS)</EmbeddingsWeightsDir>
  </PropertyGroup>

  <Import Project="weights.manifest.props" />

  <ItemGroup>
    <!-- The registration file is shipped, not compiled here. -->
    <Compile Remove="contentFiles/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneNlp.Neural/OneNlp.Neural.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="PROVENANCE.md" Pack="true" PackagePath="/" />
    <None Include="weights.manifest.props" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <Content Include="contentFiles/OneNlpModelsEmbeddingsRegistration.cs" Pack="true" PackagePath="contentFiles/cs/any/" BuildAction="Compile" PackageCopyToOutput="false" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- With a weights directory (property EmbeddingsWeightsDir or environment variable ONENLP_EMBEDDINGS_WEIGHTS): check every file against
       the manifest and embed it. Without one the project still builds (for development), but cannot be packed. -->
  <Target Name="EmbedEmbeddingsWeights" BeforeTargets="AssignTargetPaths" Condition="'$(EmbeddingsWeightsDir)' != ''">
    <ItemGroup>
      <_Weight Include="@(EmbeddingsWeight)" Path="$([MSBuild]::EnsureTrailingSlash('$(EmbeddingsWeightsDir)'))%(Identity)" WeightName="%(Identity)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Weight.Path)')" Text="Weights file '%(_Weight.WeightName)' is missing from '$(EmbeddingsWeightsDir)'. Put the files listed in src/OneNlp.Models.Embeddings/weights.manifest.props there." />
    <GetFileHash Files="@(_Weight->'%(Path)')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_WeightHashed" />
    </GetFileHash>
    <Error Condition="!$([System.String]::Equals('%(_WeightHashed.FileHash)', '%(_WeightHashed.Sha256)', System.StringComparison.OrdinalIgnoreCase))"
           Text="Weights file '%(_WeightHashed.WeightName)' does not match the manifest: sha256 %(_WeightHashed.FileHash), expected %(_WeightHashed.Sha256). Use the files listed in weights.manifest.props, or update the manifest and PROVENANCE.md together." />
    <ItemGroup>
      <EmbeddedResource Include="@(_WeightHashed)" LogicalName="weights/%(_WeightHashed.WeightName)" />
    </ItemGroup>
  </Target>

  <Target Name="RequireEmbeddingsWeightsToPack" BeforeTargets="GenerateNuspec" Condition="'$(EmbeddingsWeightsDir)' == ''">
    <Error Text="Packing needs the weights: set the environment variable ONENLP_EMBEDDINGS_WEIGHTS (or the property EmbeddingsWeightsDir) to the directory that holds the files listed in weights.manifest.props." />
  </Target>

</Project>
