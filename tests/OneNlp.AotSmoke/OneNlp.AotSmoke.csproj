<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(PackagePrefix)$(LibName).AotSmoke</RootNamespace>
    <AssemblyName>$(PackagePrefix)$(LibName).AotSmoke</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../testdata/accurate/**" Link="testdata/accurate/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneNlp/OneNlp.csproj" />
    <ProjectReference Include="../../src/OneNlp.Neural/OneNlp.Neural.csproj" />
  </ItemGroup>

</Project>
