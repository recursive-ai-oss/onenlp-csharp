# Date and time vocabulary, Portuguese (pt-BR; pt-PT is selected with region "pt"). Same sections as the French file; the roles are described in docs/recognizers.md.
#
# Dates are day first (3 de março de 2026, 03/04/2026 is 3 April). A form starting with "=" is case-sensitive, the others are matched without regard to case.
# An article that starts an expression is inside its span ("o Dia das Mães", "às 15:00"); a preposition (also fused with an article: no, na, do, pelo) is outside.

[time.region]
br

[time.month]
1 | janeiro, =jan., =jan
2 | fevereiro, =fev., =fev
3 | março, marco, =mar.
4 | abril, =abr., =abr
5 | maio, =mai.
6 | junho, =jun., =jun
7 | julho, =jul., =jul
8 | agosto, =ago., =ago
9 | setembro, =set., =set, =sept.
10 | outubro, =out., =out
11 | novembro, =nov., =nov
12 | dezembro, =dez., =dez

[time.weekday]
1 | segunda-feira, segunda feira, =seg. | segundas-feiras, segundas feiras, segundas
2 | terça-feira, terca-feira, terça feira, =ter. | terças-feiras, terças feiras, terças
3 | quarta-feira, quarta feira, =qua. | quartas-feiras, quartas feiras, quartas
4 | quinta-feira, quinta feira, =qui. | quintas-feiras, quintas feiras, quintas
5 | sexta-feira, sexta feira, =sex. | sextas-feiras, sextas feiras, sextas
6 | sábado, sabado, =sáb., =sab. | sábados, sabados
7 | domingo, =dom. | domingos

[time.unit]
second | segundo, segundos, seg | 1 | 0
minute | minuto, minutos, min | 60 | 0
hour | hora, horas | 3600 | 0
day | dia, dias, jornada, jornadas | 86400 | 0
week | semana, semanas | 604800 | 0
week | quinzena, quinzenas | 1209600 | 0
month | mês, mes, meses | 0 | 1
quarter | trimestre, trimestres | 0 | 3
year | ano, anos | 0 | 12
decade | década, décadas, decada, decadas | 0 | 120
business day | dia útil, dias úteis, dia util, dias uteis | 0 | 0

[time.season]
spring | primavera | 3 | 3
summer | verão, verao | 6 | 3
fall | outono | 9 | 3
winter | inverno | 12 | 3

[time.daypart]
morning | manhã, manha, manhãs, madrugada | 6 | 12
afternoon | tarde, tardes | 12 | 18
evening | noite, noites | 18 | 24

[time.meridiem]
am | am, a.m., a. m., a.m, a. m
pm | pm, p.m., p. m., p.m, p. m

[time.word]
today | hoje
tomorrow | amanhã, amanha
yesterday | ontem
dayaftertomorrow | depois de amanhã, depois de amanha
daybeforeyesterday | anteontem, antes de ontem
tonight | esta noite, hoje à noite, hoje a noite
noon | meio-dia, meio dia
midnight | meia-noite, meia noite
this | este, esta, estes, estas, esse, essa
next | próximo, próxima, proximo, proxima, seguinte
nextpost | próximo, próxima, proximo, proxima, que vem, seguinte
last | passado, passada, último, última, anterior
lastpost | passado, passada, anterior
agoprefix | há, ha, faz
later | mais tarde, depois
in | daqui a, dentro de, em, por, durante
at | a, ao
on | em
of | de, do, da, dos, das
and | e
rangeto | a, ao, às, até, até o, até a, -, –, —
from | de, do, da, das, dos, desde, a partir de, a partir do, a partir das
between | entre
every | todos os, todas as, toda, todo, a cada, cada
each | cada
early | início, início de, início do, começo de, começo do, princípio de, inícios de
mid | meados, meados de, meados do
late | final, final de, final do, fim de, fim do, fins de
after | depois de, depois do, após
before | antes de, antes do
half | semestre, semestres, metade, meia, meio
quarter | trimestre, trimestres
article | um, uma
the | o, a, os, as
determiner | o, a, os, as
hourarticle | às, as, à
approx | aproximadamente, cerca de, por volta de, em torno de, mais ou menos, perto de
weekend | fim de semana, fins de semana
zonebase | =UTC, =GMT
quarterprefix | =T
halfprefix | =S
hourmark | h, hs, hrs
hourword | horas, hora
oclock | em ponto
plus15 | e quinze, e um quarto
plus30 | e meia, e trinta, e meio
andhalf | e meio, e meia
minus15 | menos um quarto, menos quinze
minus | menos
clockcue | é, são, serão
daypartprefix | da, de, pela, na, à, do, de manhã
decadeprefix | anos

[time.recurrence]
P1D | day | diário, diária, diariamente, cotidiano, cotidiana
P1W | week | semanal, semanais, semanalmente
P1M | month | mensal, mensais, mensalmente
P3M | quarter | trimestral, trimestrais, trimestralmente
P1Y | year | anual, anuais, anualmente
PT1H | hour | horário, horária

[time.zone]
=UTC, =GMT | 0 | z
=WET | 0
=WEST | 60
=CET | 60
=CEST | 120
=EET | 120
=EEST | 180
=BRT | -180
=MSK | 180
=EST | -300
=EDT | -240
=CST | -360
=CDT | -300
=MST | -420
=MDT | -360
=PST | -480
=PDT | -420

# Sources: Brazil's national holidays (Lei 662/1949, Lei 10.607/2002 and Lei 14.759/2023 for 20 November); Portugal's (Código do Trabalho art. 234);
# the Christian feasts count from Easter; the rest are customary dates.
