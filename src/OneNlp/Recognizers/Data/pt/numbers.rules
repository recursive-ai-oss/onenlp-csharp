[number.fraction]
terço | 3
terços | 3
quartos | 4
quintos | 5
sextos | 6
sétimos | 7
oitavos | 8
nonos | 9
décimos | 10
centésimos | 100
milésimos | 1000

# "um" and "uma" count only inside a longer number ("trinta e um", "um milhão"); alone they are the article.
[number.lone-skip]
um, uma

[number.connector]
e

[number.negative]
menos

[number.point]
vírgula

[number.suffix]
k | 1000 | any
M | 1000000 | money
MM | 1000000000 | money

# A number written with an ending: 1.º 1.ª 2º 2ª 3.os.
[number.ordinal-suffix]
º | 0123456789 | any
ª | 0123456789 | any
.º | 0123456789 | any
.ª | 0123456789 | any
.o | 0123456789 | any
.a | 0123456789 | any

[percent]
%, por cento, porcento, por cem, ％

[age.unit]
year | ano, anos
month | mês, mes, meses
week | semana, semanas
day | dia, dias

# "82 anos de idade" is an age, "82 anos" alone is a length of time.
[age.suffix]
de idade

[number.not-number]
um | after | de, dos, das
segundo | before | por
primeira | after | hora
primeiro | after | hora
segundo | after | a, o, as, os, ele, ela, eles, elas, me, nos, nós, esse, este

# National numbers written as space-separated groups: Portuguese (Portugal) numbers have nine digits and start with 2 or 9 ("21 123 45 67").
[phone.space-start]
29 | 9 | 9
