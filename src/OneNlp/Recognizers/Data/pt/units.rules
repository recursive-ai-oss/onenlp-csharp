# Units that follow a number, Portuguese (Brazil and Portugal). Fields: canonical name | dimension | surface forms, comma-separated | confidence (optional).
# A form starting with "=" is case-sensitive; the others are matched without regard to case. Canonical names are the English ones.
# Short forms that are also common words (m, t, l) are case-sensitive.

[unit]
millimeter | length | mm, milímetro, milímetros, milimetro, milimetros
centimeter | length | cm, centímetro, centímetros, centimetro, centimetros
meter | length | =m, metro, metros
kilometer | length | km, quilômetro, quilômetros, quilómetro, quilómetros, quilometro, quilometros
micrometer | length | mícron, mícrons, micron, microns, µm, μm, micrômetro, micrômetros, micrómetro, micrómetros
inch | length | polegada, polegadas
foot | length | pé, pés
yard | length | jarda, jardas
mile | length | milha, milhas
nautical mile | length | milha náutica, milhas náuticas

milligram | mass | mg, miligrama, miligramas
gram | mass | =g, grama, gramas
