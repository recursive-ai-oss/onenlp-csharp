# Number rules for Italian (it-IT). Whole numbers below a million are one word (trecentoventiquattro, ventitré): the recognizer cuts a word into
# the parts listed in [number.cardinal], [number.part] and [number.ordinal] (stems with a trailing "~"), tens before units.
#
# Format: [section] headers, then one rule per line, fields separated by "|". "#" starts a comment. Words are matched without regard to case.

[number.digits]
system | italian
decimal | ,
group | .
negative | -−

[number.cardinal]
zero | unit | 0
uno | unit | 1
un | unit | 1
una | unit | 1
due | unit | 2
tre | unit | 3
quattro | unit | 4
cinque | unit | 5
sei | unit | 6
sette | unit | 7
otto | unit | 8
nove | unit | 9
dieci | teen | 10
undici | teen | 11
dodici | teen | 12
tredici | teen | 13
quattordici | teen | 14
quindici | teen | 15
sedici | teen | 16
diciassette | teen | 17
diciotto | teen | 18
diciannove | teen | 19
venti | tens | 20
trenta | tens | 30
quaranta | tens | 40
cinquanta | tens | 50
sessanta | tens | 60
settanta | tens | 70
ottanta | tens | 80
novanta | tens | 90
cento | bare-scale | 100
mille | bare-scale | 1000
mila | scale | 1000
milione | scale | 1000000
milioni | scale | 1000000
miliardo | scale | 1000000000
miliardi | scale | 1000000000
bilione | scale | 1000000000000
bilioni | scale | 1000000000000
dozzina | multiplier | 12
dozzine | multiplier | 12

# Pieces that only occur inside a longer number word: tré (ventitré) and the tens and hundred that lose their last vowel (ventuno, centottanta).
[number.part]
tré | unit | 3
vent | tens | 20
trent | tens | 30
quarant | tens | 40
cinquant | tens | 50
sessant | tens | 60
settant | tens | 70
ottant | tens | 80
novant | tens | 90
cent | hundred | 100

[number.ordinal]
prim~ | 1
second~ | 2 | not-after-number
terz~ | 3
quart~ | 4
quint~ | 5
sest~ | 6
settim~ | 7
ottav~ | 8
non~ | 9
decim~ | 10
undicesim~ | 11
dodicesim~ | 12
tredicesim~ | 13
quattordicesim~ | 14
quindicesim~ | 15
sedicesim~ | 16
diciassettesim~ | 17
diciottesim~ | 18
diciannovesim~ | 19
ventesim~ | 20
trentesim~ | 30
quarantesim~ | 40
cinquantesim~ | 50
sessantesim~ | 60
settantesim~ | 70
ottantesim~ | 80
novantesim~ | 90
centesim~ | 100
millesim~ | 1000
milionesim~ | 1000000
unesim~ | 1
duesim~ | 2
treesim~ | 3
quattresim~ | 4
cinquesim~ | 5
seiesim~ | 6
settesim~ | 7
ottesim~ | 8
novesim~ | 9

[number.ordinal-ending]
o, a, i, e

# The denominator a fraction word stands for: "tre quarti" is 3/4, "un terzo" is 1/3.
[number.fraction]
mezzo | 2
mezza | 2
mezzi | 2
terzo | 3
terzi | 3
quarto | 4
quarti | 4
quinto | 5
quinti | 5
sesto | 6
sesti | 6
settimo | 7
settimi | 7
ottavo | 8
ottavi | 8
noni | 9
decimi | 10
centesimi | 100
millesimi | 1000

[number.article]
un
una
uno
un'

# "un", "uno" and "una" count only inside a longer number; alone they are the article.
[number.lone-skip]
un, uno, una

[number.connector]
e

[number.negative]
meno

[number.point]
virgola

[number.suffix]
k | 1000 | any
mln | 1000000 | any
mld | 1000000000 | any

[number.ordinal-suffix]
º | 0123456789 | any
ª | 0123456789 | any
° | 0123456789 | any

# "prima di", "secondo il piano": the word is a preposition or adverb, not a position.
[number.not-number]
prima | after | di, che, d, ancora, o, dell, del, della, dei, delle, e
primo | after | di, che
secondo | after | il, lo, la, le, i, gli, l, quanto, me, te, noi, voi, lui, lei, loro, un, una, quello, quella, le
sei | before | tu, che, non, ci, se, come, dove
sei | after | un, una, stato, stata, sempre, il, la, mio, mia, tuo, tua
una | after | volta, dozzina

[percent]
%, per cento, percento, per cent, pct, ％

[age.unit]
year | anno, anni
month | mese, mesi
week | settimana, settimane
day | giorno, giorni

[age.suffix]
di età
di vita

# "di 82 anni" is an age, "82 anni" alone is not.
[age.prefix]
di

[url.tld.bare]
it
