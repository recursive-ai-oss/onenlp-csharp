between | entre
every | tous les, toutes les, chaque
each | chaque
early | début, début de, début d'
mid | mi, milieu de, milieu d', à la mi
late | fin, fin de, fin d'
after | après
before | avant
half | semestre, semestres
quarter | trimestre, trimestres
article | un, une
the | le, la, l', les
determiner | le, la, l', les
approx | environ, vers, autour de, à peu près, approximativement, aux alentours de
weekend | week-end, weekend, fin de semaine
zonebase | =UTC, =GMT
quarterprefix | =T
